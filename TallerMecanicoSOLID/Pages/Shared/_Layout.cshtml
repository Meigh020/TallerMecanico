@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AlánezMotors</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <div class="d-flex min-vh-100">

        <!-- SIDEBAR -->
        <aside class="sidebar d-flex flex-column text-white">

            <div class="p-3 border-bottom border-secondary text-center">
                <img src="~/images/alanezmotors.png" alt="AlánezMotors" class="logo-sidebar" />
            </div>

            <nav class="nav flex-column p-3 gap-2">

                @{
                    var inicioAbierto = currentPage == "/Index"
                        || currentPage.StartsWith("/Clientes")
                        || currentPage.StartsWith("/Vehiculos")
                        || currentPage.StartsWith("/Servicios")
                        || currentPage.StartsWith("/NuevoCliente")
                        || currentPage.StartsWith("/EditarCliente");
                }

                <a class="nav-link sidebar-link d-flex justify-content-between align-items-center sidebar-toggle @(currentPage == "/Index" ? "active" : "")"
                   data-bs-toggle="collapse"
                   href="#submenuInicio"
                   role="button"
                   aria-expanded="@(inicioAbierto ? "true" : "false")"
                   aria-controls="submenuInicio">

                    <span>
                        <i class="bi bi-house-door me-2"></i>
                        Inicio
                    </span>
                    <i class="bi bi-chevron-down"></i>
                </a>

                <div class="collapse @(inicioAbierto ? "show" : "")" id="submenuInicio">

                    <a asp-page="/Index"
                       class="nav-link sidebar-link sidebar-sublink @(currentPage == "/Index" ? "active" : "")">

                        <i class="bi bi-speedometer2 me-2"></i>
                        Panel
                    </a>

                    <a asp-page="/Clientes"
                       class="nav-link sidebar-link sidebar-sublink @(currentPage.StartsWith("/Clientes") || currentPage.StartsWith("/NuevoCliente") || currentPage.StartsWith("/EditarCliente") ? "active" : "")">

                        <i class="bi bi-people me-2"></i>
                        Clientes
                    </a>

                    <a asp-page="/Vehiculos"
                       class="nav-link sidebar-link sidebar-sublink @(currentPage.StartsWith("/Vehiculos") ? "active" : "")">

                        <i class="bi bi-car-front me-2"></i>
                        Vehículos
                    </a>

                    <a asp-page="/Servicios"
                       class="nav-link sidebar-link sidebar-sublink @(currentPage.StartsWith("/Servicios") ? "active" : "")">

                        <i class="bi bi-wrench-adjustable me-2"></i>
                        Servicios
                    </a>

                </div>

                <a asp-page="/OrdenesTrabajo"
                   class="nav-link sidebar-link @(currentPage.StartsWith("/OrdenesTrabajo") ? "active" : "")">

                    <i class="bi bi-clipboard-check me-2"></i>
                    Órdenes de Trabajo
                </a>

                <a asp-page="/Repuestos/Index"
                   class="nav-link sidebar-link @(currentPage.StartsWith("/Repuestos") ? "active" : "")">

                    <i class="bi bi-box-seam me-2"></i>
                    Repuestos
                </a>

                <a asp-page="/Entregas/Index"
                   class="nav-link sidebar-link @(currentPage.StartsWith("/Entregas") ? "active" : "")">

                    <i class="bi bi-truck me-2"></i>
                    Entregas
                </a>

            </nav>

        </aside>

        <!-- CONTENIDO -->
        <div class="flex-grow-1 bg-light">

            <!-- CABECERA -->
            <header class="bg-white border-bottom px-4 py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="mb-0 fw-semibold">
                        @ViewData["Title"]
                    </h5>

                    <div class="d-flex align-items-center gap-4 text-secondary">

                        <div>
                            <i class="bi bi-calendar3 me-2"></i>
                            @DateTime.Now.ToString("dd/MM/yyyy")
                        </div>

                        <div>
                            <i class="bi bi-person-circle fs-5 me-2 text-primary"></i>
                            Administrador
                        </div>

                    </div>

                </div>

            </header>

            <main class="p-4">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>