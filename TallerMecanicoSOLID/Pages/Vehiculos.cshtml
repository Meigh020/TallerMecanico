
@page
@model TallerMecanicoSOLID.Pages.VehiculosModel

@{
    ViewData["Title"] = "Vehículos";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Vehículos
            </h2>

            <p class="text-muted mb-0">
                Registro de vehículos del taller
            </p>
        </div>

        <a asp-page="/NuevoVehiculo"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>
            Nuevo Vehículo

        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form method="get"
                  class="row mb-3">

                <div class="col-md-6">

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               name="buscar"
                               value="@Model.Buscar"
                               class="form-control"
                               placeholder="Buscar por placa, marca, modelo o cliente..." />

                        <button type="submit"
                                class="btn btn-primary">

                            Buscar

                        </button>

                    </div>

                </div>

            </form>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Mensaje"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @if (Model.ListaVehiculos.Count == 0)
            {
                if (!string.IsNullOrWhiteSpace(Model.Buscar))
                {
                    <div class="alert alert-info">
                        No se encontraron vehículos para "@Model.Buscar".
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary">
                        No hay vehículos registrados.
                    </div>
                }
            }

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>N°</th>
                            <th>Placa</th>
                            <th>Cliente</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Año</th>
                            <th>Color</th>
                            <th>Tipo</th>
                            <th>Kilometraje</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @for (int i = 0; i < Model.ListaVehiculos.Count; i++)
                        {
                            var vehiculo = Model.ListaVehiculos[i];
                            var token = Model.GenerarToken(vehiculo.Id);

                            <tr>

                                <td>
                                    @(i + 1)
                                </td>

                                <td class="fw-semibold">
                                    @vehiculo.Placa
                                </td>

                                <td>
                                    @vehiculo.ClienteNombre
                                </td>

                                <td>
                                    @vehiculo.Marca
                                </td>

                                <td>
                                    @vehiculo.Modelo
                                </td>

                                <td>
                                    @vehiculo.Anio
                                </td>

                                <td>
                                    @vehiculo.Color
                                </td>

                                <td>
                                    @vehiculo.Tipo
                                </td>

                                <td>
                                    @vehiculo.Kilometraje.ToString("N0") km
                                </td>

                                <td>

                                    @if (vehiculo.Estado)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td>

                                    <!-- EDITAR -->

                                    <a asp-page="/EditarVehiculo"
                                       asp-route-id="@token"
                                       class="btn btn-sm btn-warning">

                                        <i class="bi bi-pencil"></i>
                                        Editar

                                    </a>

                                    <!-- ELIMINAR -->

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminarVehiculo-@vehiculo.Id">

                                        <i class="bi bi-trash"></i>
                                        Eliminar

                                    </button>

                                    <!-- MODAL ELIMINAR -->

                                    <div class="modal fade"
                                         id="modalEliminarVehiculo-@vehiculo.Id"
                                         tabindex="-1"
                                         aria-hidden="true">

                                        <div class="modal-dialog modal-dialog-centered">

                                            <div class="modal-content">

                                                <div class="modal-header">

                                                    <h5 class="modal-title">
                                                        Confirmar eliminación
                                                    </h5>

                                                    <button type="button"
                                                            class="btn-close"
                                                            data-bs-dismiss="modal">
                                                    </button>

                                                </div>

                                                <div class="modal-body">

                                                    ¿Está seguro que desea eliminar el vehículo con placa:

                                                    <strong>
                                                        @vehiculo.Placa
                                                    </strong>?

                                                </div>

                                                <div class="modal-footer">

                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            data-bs-dismiss="modal">

                                                        Cancelar

                                                    </button>

                                                    <form method="post"
                                                          asp-page-handler="Eliminar">

                                                        <input type="hidden"
                                                               name="token"
                                                               value="@token" />

                                                        <button type="submit"
                                                                class="btn btn-danger">

                                                            Eliminar

                                                        </button>

                                                    </form>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
